<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone through cloud backup or device transfer: the enrollment is bound
     to the Keystore keys, which cannot be moved, and a restored copy would be useless. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
